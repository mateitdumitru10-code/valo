# Cloudflare Pages reads this from the build output; Netlify takes the same
# rules from netlify.toml.

# Vite hashes these filenames, so they can never change under the same name.
/assets/*
  cache-control: public, max-age=31536000, immutable

# Media filenames are stable, not hashed: hero.mp4 stays hero.mp4 when the clip
# is re-encoded. Marking it immutable would leave returning visitors on a
# year-stale file, so it revalidates in the background instead.
/media/*
  cache-control: public, max-age=604800, stale-while-revalidate=86400

# Catalogue detail, fetched when a piece is opened. The filename is the slug,
# so a re-shot piece keeps it — and a week of cache meant a deploy that changed
# the photography did not reach anyone who had opened the page before. These
# are a few kilobytes each: revalidate every time and let the ETag answer.
/data/*
  cache-control: public, max-age=0, must-revalidate

# Until release the site lives only on Cloudflare's own addresses, while every
# page names https://vallo.ro as its canonical (src/lib/seo.ts). Search engines
# are told to keep these copies out of the index, so vallo.ro starts clean
# rather than competing with its own staging. The rules match only the
# pages.dev hosts — production and branch previews — never vallo.ro. robots.txt
# must not block these hosts: a crawler that cannot fetch a page never reads
# this header.
https://:project.pages.dev/*
  x-robots-tag: noindex

https://:version.:project.pages.dev/*
  x-robots-tag: noindex
