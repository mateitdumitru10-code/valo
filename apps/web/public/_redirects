# Cloudflare Pages reads this file from the build output.
#
# /api/inquiries is a Pages Function (functions/api/inquiries.ts); any other
# /api address has no function and gets 404.html with a 404, like every
# address that was not built.

# The product listing moved from /piese to /produse. Old links, bookmarks and
# search results get a permanent redirect rather than the SPA's not-found page.
# Cubiq was renamed Cubic; its two pieces moved with it.
/produse/canapea-cubiq  /produse/canapea-cubic  301
/produse/modul-cubiq    /produse/modul-cubic    301
/piese/canapea-cubiq    /produse/canapea-cubic  301
/piese/modul-cubiq      /produse/modul-cubic    301

/piese    /produse    301
/piese/*  /produse/:splat  301

# The atelier page was retired; its address goes to the home page.
/atelier  /  301

# Every page is prerendered to its own file (scripts/prerender.mjs), so there
# is no catch-all to index.html any more: it answered addresses that do not
# exist with the home page and a 200, which search engines count against the
# site. Anything not built is now answered by 404.html, with a 404 status.
