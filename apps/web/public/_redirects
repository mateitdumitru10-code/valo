# Cloudflare Pages and Netlify both read this file from the build output.
# netlify.toml covers Netlify already; this is what makes Cloudflare behave.

# The API is a long-running Express process and exists on neither host. This
# rule must come first: without it the SPA fallback below would answer
# /api/inquiries with index.html and a 200, and the quote form would report
# success for a request nobody received.
/api/*  /index.html  404

# The product listing moved from /piese to /produse. Old links, bookmarks and
# search results get a permanent redirect rather than the SPA's not-found page.
# Cubiq was renamed Cubic; its two pieces moved with it.
/produse/canapea-cubiq  /produse/canapea-cubic  301
/produse/modul-cubiq    /produse/modul-cubic    301
/piese/canapea-cubiq    /produse/canapea-cubic  301
/piese/modul-cubiq      /produse/modul-cubic    301

/piese    /produse    301
/piese/*  /produse/:splat  301

# The atelier page was retired; its address goes to the home page.
/atelier  /  301

# Single-page app: every route is rendered by the client, so any path that is
# not a real file has to be served index.html — otherwise a direct visit to
# /produse/coltar-aldo asks for a file that was never built.
/*  /index.html  200
